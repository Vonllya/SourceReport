# 模型与搜索服务。默认使用 DeepSeek V4 Flash 和 Tavily。
LLM_PROVIDER=deepseek
SEARCH_PROVIDER=tavily

# 模型服务密钥。使用其他 OpenAI 兼容服务时，同步修改 provider、接口地址和模型名。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash

# DeepSeek 思考模式：disabled 或 enabled；默认关闭以稳定生成结构化结果。
LLM_THINKING_MODE=disabled
# 仅在开启思考模式时生效。
LLM_REASONING_EFFORT=low

# 各类步骤的输出 Token 上限。
LLM_MAX_TOKENS_STRUCTURED=4096
LLM_MAX_TOKENS_CITATION_AUDIT=4096
LLM_MAX_TOKENS_REPORT=4096

# 单次模型请求超时（秒）和临时服务错误的最大重试次数。
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# Tavily 搜索服务密钥和请求超时（秒）。
TAVILY_API_KEY=
SEARCH_TIMEOUT_SECONDS=20

# 本地任务数据库路径和日志级别。
SOURCEREPORT_DB=data/sourcereport.db
SOURCEREPORT_LOG_LEVEL=INFO
